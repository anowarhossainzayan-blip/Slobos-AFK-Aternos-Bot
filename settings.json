
const mineflayer = require("mineflayer");

const bot = mineflayer.createBot({
    host: "PZJMsmp.aternos.me",
    port: 25565,

    username: "staff56",

    // Change this to the EXACT version
    // shown by your Aternos server.
    version: "26.3",

    // Only use this if your server allows
    // offline/cracked accounts.
    auth: "offline"
});

bot.once("spawn", () => {
    console.log("================================");
    console.log("staff56 is ONLINE!");
    console.log("================================");

    // Simple human-like movement
    setInterval(() => {

        if (!bot.entity) return;

        const actions = [
            "forward",
            "back",
            "left",
            "right"
        ];

        const action =
            actions[
                Math.floor(
                    Math.random() * actions.length
                )
            ];

        bot.setControlState(action, true);

        setTimeout(() => {

            if (bot) {
                bot.setControlState(action, false);
            }

        }, 1000 + Math.random() * 3000);

    }, 5000);
});


bot.on("chat", (username, message) => {

    if (username === bot.username) return;

    console.log(
        `${username}: ${message}`
    );

});


bot.on("error", (error) => {

    console.log(
        "BOT ERROR:",
        error.message
    );

});


bot.on("kicked", (reason) => {

    console.log(
        "BOT KICKED:",
        reason
    );

});


bot.on("end", () => {

    console.log(
        "Bot disconnected."
    );

    console.log(
        "Restarting in 10 seconds..."
    );

    setTimeout(() => {

        process.exit(1);

    }, 10000);
});

